# Copy this file to .env and adjust as needed.
# NOTE: Spring Boot does not auto-load .env files by default — these are meant
# to be set as real OS environment variables (or via your IDE's run config,
# or docker-compose, which already wires these up for you).

# Leave all of these unset for local development — the backend automatically
# falls back to an in-memory H2 database with zero setup.

# --- Uncomment and fill in to use a real MySQL database instead ---
# DB_URL=jdbc:mysql://localhost:3306/snakesafe?createDatabaseIfNotExist=true&useSSL=false
# DB_USER=root
# DB_PASSWORD=your_password_here
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

# --- AI microservice location (default shown) ---
# AI_SERVICE_URL=http://localhost:8000
